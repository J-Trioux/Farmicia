# Dépendances
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Compilation et exécution
/.next/
/.vinext/
/out/
/dist/
/.wrangler/
/coverage
next-env.d.ts
*.tsbuildinfo

# Environnement local
.env*
*.pem
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
__pycache__/
.vercel

# Atelier : ce qui ne sert pas à faire tourner le jeu publié.
# Ces dossiers restent sur le poste de travail, hors du dépôt :
# sources et planches HD, archives de versions, scripts de
# fabrication des images, suites de tests.
/assets/
/releases/
/scripts/
/tests/
/outputs/
/work/
/.sites-runtime/

# Documentation : seule l'image du README est versionnée.
/docs/*
!/docs/apercu.webp

# Atelier de Claude : captures, essais et instantanés (jamais publiés).
/Claude outputs/
